# ---------------------------------------------------------------------------
# Macronaut environment
#
# Every value here is optional. With none of them set the app still runs:
#   - no Supabase -> "solo mode": one local pilot, no sign-in, data in a JSON file
#   - no Gemini   -> built-in food estimator + template coaching
# Copy this file to .env.local and fill in only what you want.
# ---------------------------------------------------------------------------

# --- AI (Google Gemini) -----------------------------------------------------
# https://aistudio.google.com/apikey — the free tier is enough. Server-side only.
#
# With Supabase on, each person adds their own key during onboarding and this
# one is only used for the accounts in MACRONAUT_AI_PRIORITY_EMAILS. In solo
# mode it powers everything.
GEMINI_API_KEY=

# Encrypts the Gemini keys people save. Required once Supabase is on. Any long
# random string, e.g. `openssl rand -base64 32`. Changing it makes saved keys
# unreadable, so everyone would need to add theirs again.
MACRONAUT_ENCRYPTION_KEY=
# Optional. "true" lets every account use GEMINI_API_KEY above.
# MACRONAUT_SHARE_SERVER_KEY=false
# Optional. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash
# Optional. Comma-separated models tried in order when the primary is
# rate-limited or unavailable.
# GEMINI_FALLBACK_MODELS=

# Optional. Ceiling on calls made on GEMINI_API_KEY per day (default 400).
# MACRONAUT_AI_GLOBAL_DAILY_LIMIT=400
# Comma-separated emails that use GEMINI_API_KEY — usually just yours — and
# are still served once that ceiling is reached.
# MACRONAUT_AI_PRIORITY_EMAILS=

# --- Accounts + database (Supabase) -----------------------------------------
# https://supabase.com/dashboard -> Project Settings -> API.
# Apply the schema first: npx supabase db push (runs supabase/migrations/).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the reminder cron and account deletion, never sent to
# the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Push reminders (optional) ----------------------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach, e.g. mailto:you@example.com
VAPID_SUBJECT=
# Guards /api/cron/reminders. Vercel Cron sends it as a Bearer token automatically.
CRON_SECRET=

# --- Solo mode --------------------------------------------------------------
# Where the local JSON store lives, relative to the project root.
# MACRONAUT_DATA_FILE=.data/macronaut.json
